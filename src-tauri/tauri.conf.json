{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacDows",
  "version": "0.1.0",
  "identifier": "dev.macdows.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MacDows",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEQzZCM0I1N0M1RjYzNUQKUldSZFkxOTh0YlBHSFFhNnJPb29nOEthbFAxWktqYnc2NElkNWQ2V2hrUXJEdm1PUlpDaEo5RVcK",
      "endpoints": [
        "https://github.com/Fatal-IV/MacDows/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
