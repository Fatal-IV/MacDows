{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacDows Setup",
  "version": "0.2.0",
  "identifier": "dev.macdows.setup",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "setup",
        "title": "MacDows Setup",
        "width": 560,
        "height": 380,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
