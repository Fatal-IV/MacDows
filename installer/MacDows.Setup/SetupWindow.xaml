<Window x:Class="MacDows.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacDows Kurulumu" Width="560" Height="380"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#0067C0" CornerRadius="8" Padding="40,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Foreground" Value="#1B1C20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#B3FFFFFF" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" Padding="26,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetupProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#1F000000" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="#0067C0" CornerRadius="3" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Wordmark" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Foreground" Value="#1B1C20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6D7078" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="16" BorderBrush="#22000000" BorderThickness="1" MouseLeftButtonDown="OnDrag">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Color="#EEF1F6" Offset="0" />
                <GradientStop Color="#E9E6DF" Offset="0.55" />
                <GradientStop Color="#E4E0D8" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" /></Border.Effect>
        <Grid>
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" Width="30" Height="28"
                    Background="Transparent" BorderThickness="0" Foreground="#6D7078" Cursor="Hand" Click="OnCloseClick" />

            <StackPanel x:Name="ReadyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="logo.png" Width="76" Height="76" HorizontalAlignment="Center" />
                <TextBlock Text="MacDows" Style="{StaticResource Wordmark}" Margin="0,14,0,0" />
                <TextBlock Text="Windows için çentik ve dock" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <Button Content="Kur" Style="{StaticResource AccentButton}" Margin="0,26,0,0" HorizontalAlignment="Center" Click="OnInstallClick" IsDefault="True" />
                <TextBlock Text="Kur'a basarak kullanım koşullarını (GPL-3.0) kabul edersiniz." FontSize="11" Style="{StaticResource Muted}" Margin="0,14,0,0" />
            </StackPanel>

            <StackPanel x:Name="WorkingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="280" Visibility="Collapsed">
                <Image Source="logo.png" Width="76" Height="76" HorizontalAlignment="Center" />
                <TextBlock Text="MacDows" Style="{StaticResource Wordmark}" Margin="0,14,0,0" />
                <ProgressBar x:Name="Bar" Style="{StaticResource SetupProgress}" Minimum="0" Maximum="100" Margin="0,24,0,0" />
                <TextBlock x:Name="StatusText" Text="Kuruluyor…" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel x:Name="DonePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="480" Visibility="Collapsed">
                <Border Width="52" Height="52" CornerRadius="26" Background="#2E9E6B" HorizontalAlignment="Center">
                    <TextBlock Text="✓" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Hazır" Style="{StaticResource Wordmark}" FontSize="34" Margin="0,16,0,0" />
                <TextBlock Text="MacDows kuruldu." Style="{StaticResource Muted}" Margin="0,6,0,0" />
                <Button Content="MacDows'u aç" Style="{StaticResource AccentButton}" Margin="0,24,0,0" HorizontalAlignment="Center" Click="OnLaunchClick" IsDefault="True" />
            </StackPanel>

            <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="460" Visibility="Collapsed">
                <Border Width="52" Height="52" CornerRadius="26" Background="#C42B1C" HorizontalAlignment="Center">
                    <TextBlock Text="!" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Kurulum tamamlanamadı" Style="{StaticResource Wordmark}" FontSize="24" Margin="0,16,0,0" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Content="Kapat" Style="{StaticResource QuietButton}" Click="OnCloseClick" Margin="0,0,10,0" />
                    <Button Content="Yeniden dene" Style="{StaticResource AccentButton}" Click="OnInstallClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
